<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<!--
  NTD-reference cover layout. Annotation colors are intentionally omitted.
  record is the custom OBJECT supplied by bc_pdf_renderer.renderTransmittalCover,
  not a native transaction record binding.
  Green reference areas remain blank for handwritten/manual completion.
  General Contractor remains blank pending confirmation (red reference area).
  Optional values not currently supplied by the renderer:
  specTitle, supplierAddress, supplierCityStateZip,
  supplierContact, supplierPhone, supplierFax, manufacturer.
  Missing optional values render blank; example-project data is never hard-coded.
  Product Summary appears on page 2 only when items exist.
-->
<pdf>
<#function clean value>
  <#local text = value?string?trim />
  <#if text == "null" || text == "undefined"><#return "" /></#if>
  <#return text />
</#function>
<head>
  <link name="NotoSans" type="font" subtype="truetype"
        src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}"
        src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
  <style>
    * { font-family: NotoSans, sans-serif; color: #000000; }
    body { font-size: 9pt; }
    table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    td, th { vertical-align: top; padding: 2pt 3pt; }
    .brand td { padding: 0; }
    .title { font-size: 15pt; font-weight: bold; }
    .company { font-size: 10pt; font-weight: bold; }
    .project { margin-top: 7pt; margin-bottom: 10pt; font-size: 11pt; font-weight: bold; }
    .grid td { border: 0.5pt solid #000000; }
    .label { font-size: 7pt; font-weight: normal; }
    .value { font-size: 9pt; font-weight: bold; }
    .section { font-size: 11pt; font-weight: bold; }
    .cert { font-size: 8pt; line-height: 12pt; }
    .party td { border: 0.5pt solid #000000; padding: 2pt 3pt; }
    .blank { height: 24pt; }
    .supplier-row { height: 28pt; }
    .party-title { font-size: 11pt; font-weight: bold; }
    .lines-head { font-size: 12pt; font-weight: bold; margin-bottom: 6pt; }
    .lines table th { font-size: 9pt; font-weight: bold; border-bottom: 1pt solid #000000; }
    .lines table td { font-size: 9pt; border-bottom: 0.5pt solid #999999; }
    .lines .right { text-align: right; }
    .lines .num { width: 24pt; text-align: center; }
    .lines .empty { padding: 16pt; font-style: italic; }
    .pageinfo { font-size: 7pt; }
  </style>
  <macrolist>
    <macro id="footer">
      <table><tr>
        <td class="pageinfo">${clean(record.submittalNumber!"")?xml} ${clean(record.revisionLabel!"")?xml}</td>
        <td class="pageinfo" align="right">Page <pagenumber/> of <totalpages/></td>
      </tr></table>
    </macro>
  </macrolist>
</head>
<body padding="0.3in 0.3in 0.45in 0.3in" size="Letter" footer="footer" footer-height="0.25in">
  <table class="brand">
    <tr>
      <td width="30%" height="70pt">
        <img src="https://6962009-sb2.app.netsuite.com/core/media/media.nl?id=604574&amp;c=6962009_SB2&amp;h=DDkKiZ53eOxFt_PfdQbc8rBBU-vyU8msiyhY9n4oPZNkBdKK" width="105pt" height="65pt" />
      </td>
      <td width="40%" align="center" class="title">Submittal Cover</td>
      <td width="30%" align="right" class="company">
        <p align="right" style="margin: 0; padding: 0; text-align: right;">${clean(record.subsidiaryName!"")?xml}</p>
        <#if (record.subsidiaryAddress!"")?has_content>
          <#list record.subsidiaryAddress?replace("<br />", "<br/>")?replace("<br>", "<br/>")?split("<br/>") as addressLine>
            <p align="right" style="margin: 0; padding: 0; text-align: right;">${addressLine?xml}</p>
          </#list>
        </#if>
        <#if (record.subsidiaryPhone!"")?has_content>
          <p align="right" style="margin: 0; padding: 0; text-align: right;">${record.subsidiaryPhone?xml}</p>
        </#if>
      </td>
    </tr>
  </table>
  <table class="project"><tr><td>
    Project: ${clean(record.projectName!"")?xml}<br/>
    Project No. ${clean(record.projectNumber!"")?xml}
  </td></tr></table>
  <table class="grid">
    <tr>
      <td width="25%"><span class="label">Submittal No.</span><br/><span class="value">${clean(record.submittalNumber!"")?xml}</span></td>
      <td width="75%"><span class="label">Date:</span><br/><span class="value">${clean(record.submittalDate!"")?xml}</span></td>
    </tr>
    <tr><td colspan="2"><span class="label">Product Submitted:</span><br/>
      <table><tr><td align="center" class="value" style="border: none;">${clean(record.title!"")?xml}</td></tr></table>
    </td></tr>
    <tr><td colspan="2"><span class="label">Manufacturer</span><br/>
      <table><tr><td align="center" class="value" style="border: none;">
        <#if (record.manufacturer!"")?has_content>
          ${record.manufacturer?xml}
        <#else>
          <#assign manufacturers = [] />
          <#list (record.lines![]) as item>
            <#assign manufacturer = (item.manufacturer!"")?trim />
            <#if manufacturer?has_content && !(manufacturers?seq_contains(manufacturer))>
              <#assign manufacturers = manufacturers + [manufacturer] />
            </#if>
          </#list>
          <#list manufacturers as manufacturer>${manufacturer?xml}<#if manufacturer_has_next>, </#if></#list>
        </#if>
      </td></tr></table>
    </td></tr>
    <tr>
      <td><span class="label">Spec. Section</span><br/><span class="value">${clean(record.specSection!"")?xml}</span></td>
      <td><span class="label">Spec. Title</span><br/><span class="value">${clean(record.specTitle!"")?xml}</span></td>
    </tr>
  </table>
  <!-- One six-column grid keeps supplier and certification exactly half-width. -->
  <table class="grid" width="568pt" style="width: 568pt; table-layout: fixed;">
    <tr>
      <td width="100pt" style="width: 100pt; border: none; padding: 0; height: 0pt;"></td>
      <td width="92pt" style="width: 92pt; border: none; padding: 0; height: 0pt;"></td>
      <td width="92pt" style="width: 92pt; border: none; padding: 0; height: 0pt;"></td>
      <td width="100pt" style="width: 100pt; border: none; padding: 0; height: 0pt;"></td>
      <td width="92pt" style="width: 92pt; border: none; padding: 0; height: 0pt;"></td>
      <td width="92pt" style="width: 92pt; border: none; padding: 0; height: 0pt;"></td>
    </tr>
    <tr><td colspan="6" class="section" style="border: none; padding: 4pt 0 3pt 0;">Product Supplier</td></tr>
    <tr>
      <td colspan="3" height="28pt" class="supplier-row"><span class="label">Company</span><br/><span class="value">${clean(record.vendor!"")?xml}&#160;</span></td>
      <td colspan="3" rowspan="4" width="284pt" style="width: 284pt; padding: 6pt; vertical-align: top;" class="cert">
        <b><u>Subcontractor Certification of Compliance:</u></b><br/>
        I hereby certify that the product data contained in this submittal package has been reviewed for compliance with the intent of the Contract Documents and coordinated with the project requirements.
        <br/><br/>By: ____________________&#160;&#160; ${clean(record.submittalDate!"")?xml}
      </td>
    </tr>
    <tr><td colspan="3" height="28pt" class="supplier-row"><span class="label">Address</span><br/><span class="value">${clean(record.supplierAddress!"")?xml}&#160;</span></td></tr>
    <tr><td colspan="3" height="28pt" class="supplier-row"><span class="label">City, State, Zip</span><br/><span class="value">${clean(record.supplierCityStateZip!"")?xml}&#160;</span></td></tr>
    <tr>
      <td height="28pt" class="supplier-row"><span class="label">Contact:</span><br/><span class="value">${clean(record.supplierContact!"")?xml}&#160;</span></td>
      <td height="28pt" class="supplier-row"><span class="label">Phone:</span><br/><span class="value">${clean(record.supplierPhone!"")?xml}&#160;</span></td>
      <td height="28pt" class="supplier-row"><span class="label">Fax:</span><br/><span class="value">${clean(record.supplierFax!"")?xml}&#160;</span></td>
    </tr>
  </table>
  <table width="568pt" style="width: 568pt; table-layout: fixed; margin-top: 12pt;"><tr>
    <td width="284pt" style="width: 284pt; padding: 0;">
      <table class="party">
        <tr><td colspan="3" align="center" class="party-title">Architect</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">Name</span><br/>&#160;</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">Address</span><br/>&#160;</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">City, State, Zip</span><br/>&#160;</td></tr>
        <tr>
          <td width="35%" class="blank"><span class="label">Proj. No.</span><br/>&#160;</td>
          <td width="31%" class="blank"><span class="label">Phone:</span><br/>&#160;</td>
          <td width="34%" class="blank"><span class="label">Fax:</span><br/>&#160;</td>
        </tr>
        <tr><td colspan="3" align="center" class="party-title">Engineer</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">Name</span><br/>&#160;</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">Address</span><br/>&#160;</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">City, State, Zip</span><br/>&#160;</td></tr>
        <tr>
          <td width="35%" class="blank"><span class="label">Proj. No.</span><br/>&#160;</td>
          <td width="31%" class="blank"><span class="label">Phone:</span><br/>&#160;</td>
          <td width="34%" class="blank"><span class="label">Fax:</span><br/>&#160;</td>
        </tr>
        <tr><td colspan="3" align="center" class="party-title">General Contractor</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">Name</span><br/>&#160;</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">Address</span><br/>&#160;</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">City, State, Zip</span><br/>&#160;</td></tr>
        <tr>
          <td width="35%" class="blank"><span class="label">Proj. No.</span><br/>&#160;</td>
          <td width="31%" class="blank"><span class="label">Phone:</span><br/>&#160;</td>
          <td width="34%" class="blank"><span class="label">Fax:</span><br/>&#160;</td>
        </tr>
      </table>
    </td>
    <td width="16pt" style="width: 16pt; padding: 0;"></td>
    <td width="268pt" style="width: 268pt; border: 0.5pt solid #000000; padding: 4pt;">Reviewer Stamp</td>
  </tr></table>
  <!-- Omit the summary page when there are no product items. -->
  <#if (record.lines![])?size &gt; 0>
    <pbr/>
    <table><tr><td class="lines-head">Product Summary</td></tr></table>
    <table class="grid" style="table-layout: fixed;">
      <thead><tr>
        <th width="5%">#</th>
        <th width="29%">Description</th>
        <th width="16%">Model</th>
        <th width="20%">Manufacturer</th>
        <th width="8%" align="right">Qty</th>
        <th width="8%">UoM</th>
        <th width="14%" align="right">Unit Cost</th>
      </tr></thead>
      <tbody>
        <#list record.lines as item>
          <tr>
            <td>${clean(item.position!"")?xml}</td>
            <td>${clean(item.description!"")?xml}</td>
            <td>${clean(item.model!"")?xml}</td>
            <td>${clean(item.manufacturer!"")?xml}</td>
            <td align="right">${clean(item.qty!"")?xml}</td>
            <td>${clean(item.uom!"")?xml}</td>
            <td align="right">${clean(item.unitCost!"")?xml}</td>
          </tr>
        </#list>
      </tbody>
    </table>
  </#if>
</body>
</pdf>
