<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<!--
  NTD-reference cover layout. Annotation colors are intentionally omitted.
  record is the custom OBJECT supplied by bc_pdf_renderer.renderTransmittalCover,
  not a native transaction record binding.
  Green reference areas remain blank for handwritten/manual completion.
  General Contractor remains blank pending confirmation (red reference area).
  Optional values not currently supplied by the renderer:
  subsidiaryPhone, projectNumber, specTitle, supplierAddress, supplierCityStateZip,
  supplierContact, supplierPhone, supplierFax, manufacturer.
  Missing optional values render blank; example-project data is never hard-coded.
  Existing Product Summary remains on page 2.
-->
<pdf>
<head>
  <link name="NotoSans" type="font" subtype="truetype"
        src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}"
        src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
  <style>
    * { font-family: NotoSans, sans-serif; color: #000000; }
    body { font-size: 9pt; }
    table { width: 100%; border-collapse: collapse; }
    td, th { vertical-align: top; padding: 2pt 3pt; }
    .brand td { padding: 0; }
    .title { font-size: 15pt; font-weight: bold; }
    .company { font-size: 10pt; font-weight: bold; }
    .project { margin-top: 7pt; margin-bottom: 10pt; font-size: 11pt; font-weight: bold; }
    .grid td { border: 0.5pt solid #000000; }
    .label { font-size: 7pt; font-weight: normal; }
    .value { font-size: 9pt; font-weight: bold; }
    .section { font-size: 11pt; font-weight: bold; }
    .cert { font-size: 8pt; line-height: 12pt; }
    .party td { border: 0.5pt solid #000000; padding: 2pt 3pt; }
    .blank { height: 24pt; }
    .party-title { font-size: 11pt; font-weight: bold; }
    .lines-head { font-size: 12pt; font-weight: bold; margin-bottom: 6pt; }
    .lines table th { font-size: 9pt; font-weight: bold; border-bottom: 1pt solid #000000; }
    .lines table td { font-size: 9pt; border-bottom: 0.5pt solid #999999; }
    .lines .right { text-align: right; }
    .lines .num { width: 24pt; text-align: center; }
    .lines .empty { padding: 16pt; font-style: italic; }
    .pageinfo { font-size: 7pt; }
  </style>
  <macrolist>
    <macro id="footer">
      <table><tr>
        <td class="pageinfo">${(record.submittalNumber!"")?xml} ${ (record.revisionLabel!"")?xml}</td>
        <td class="pageinfo" align="right">Page <pagenumber/> of <totalpages/></td>
      </tr></table>
    </macro>
  </macrolist>
</head>
<body padding="0.3in 0.3in 0.45in 0.3in" size="Letter" footer="footer" footer-height="0.25in">
  <table class="brand">
    <tr>
      <td width="25%" height="70pt">
        <img src="https://6962009-sb2.app.netsuite.com/core/media/media.nl?id=604574&amp;c=6962009_SB2&amp;h=DDkKiZ53eOxFt_PfdQbc8rBBU-vyU8msiyhY9n4oPZNkBdKK" width="105pt" height="65pt" />
      </td>
      <td width="40%" align="center" class="title">Submittal Cover</td>
      <td width="35%" align="right" class="company">
        ${(record.subsidiaryName!"")?xml}
        <#if (record.subsidiaryAddress!"")?has_content>
          <#list record.subsidiaryAddress?replace("<br />", "<br/>")?replace("<br>", "<br/>")?split("<br/>") as addressLine>
            <br/>${addressLine?xml}
          </#list>
        </#if>
        <#if (record.subsidiaryPhone!"")?has_content><br/>${record.subsidiaryPhone?xml}</#if>
      </td>
    </tr>
  </table>
  <table class="project"><tr><td>
    Project: ${(record.projectName!"")?xml}<br/>
    Project No. ${(record.projectNumber!"")?xml}
  </td></tr></table>
  <table class="grid">
    <tr>
      <td width="25%"><span class="label">Submittal No.</span><br/><span class="value">${(record.submittalNumber!"")?xml}</span></td>
      <td width="75%"><span class="label">Date:</span><br/><span class="value">${(record.submittalDate!"")?xml}</span></td>
    </tr>
    <tr><td colspan="2"><span class="label">Product Submitted:</span><br/>
      <table><tr><td align="center" class="value" style="border: none;">${(record.title!"")?xml}</td></tr></table>
    </td></tr>
    <tr><td colspan="2"><span class="label">Manufacturer</span><br/>
      <table><tr><td align="center" class="value" style="border: none;">
        <#if (record.manufacturer!"")?has_content>
          ${record.manufacturer?xml}
        <#else>
          <#assign manufacturers = [] />
          <#list (record.lines![]) as item>
            <#assign manufacturer = (item.manufacturer!"")?trim />
            <#if manufacturer?has_content && !(manufacturers?seq_contains(manufacturer))>
              <#assign manufacturers = manufacturers + [manufacturer] />
            </#if>
          </#list>
          <#list manufacturers as manufacturer>${manufacturer?xml}<#if manufacturer_has_next>, </#if></#list>
        </#if>
      </td></tr></table>
    </td></tr>
    <tr>
      <td><span class="label">Spec. Section</span><br/><span class="value">${(record.specSection!"")?xml}</span></td>
      <td><span class="label">Spec. Title</span><br/><span class="value">${(record.specTitle!"")?xml}</span></td>
    </tr>
  </table>
  <table><tr><td class="section" style="padding: 3pt 0;">Product Supplier</td></tr></table>
  <table><tr>
    <td width="50%" style="padding: 0;">
      <table class="grid">
        <tr><td colspan="3"><span class="label">Company</span><br/><span class="value">${(record.vendor!"")?xml}</span></td></tr>
        <tr><td colspan="3"><span class="label">Address</span><br/><span class="value">${(record.supplierAddress!"")?xml}</span></td></tr>
        <tr><td colspan="3"><span class="label">City, State, Zip</span><br/><span class="value">${(record.supplierCityStateZip!"")?xml}</span></td></tr>
        <tr>
          <td width="35%"><span class="label">Contact:</span><br/><span class="value">${(record.supplierContact!"")?xml}</span></td>
          <td width="31%"><span class="label">Phone:</span><br/><span class="value">${(record.supplierPhone!"")?xml}</span></td>
          <td width="34%"><span class="label">Fax:</span><br/><span class="value">${(record.supplierFax!"")?xml}</span></td>
        </tr>
      </table>
    </td>
    <td width="50%" style="border: 0.5pt solid #000000; padding: 5pt;" class="cert">
      <b><u>Subcontractor Certification of Compliance:</u></b><br/>
      I hereby certify that the product data contained in this submittal package has been reviewed for compliance with the intent of the Contract Documents and coordinated with the project requirements.
      <br/><br/>By: _______________________&#160; ${ (record.submittalDate!"")?xml}
    </td>
  </tr></table>
  <table style="margin-top: 12pt;"><tr>
    <td width="50%" style="padding: 0;">
      <table class="party">
        <tr><td colspan="3" align="center" class="party-title">Architect</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">Name</span><br/>&#160;</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">Address</span><br/>&#160;</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">City, State, Zip</span><br/>&#160;</td></tr>
        <tr>
          <td width="35%" class="blank"><span class="label">Proj. No.</span><br/>&#160;</td>
          <td width="31%" class="blank"><span class="label">Phone:</span><br/>&#160;</td>
          <td width="34%" class="blank"><span class="label">Fax:</span><br/>&#160;</td>
        </tr>
        <tr><td colspan="3" align="center" class="party-title">Engineer</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">Name</span><br/>&#160;</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">Address</span><br/>&#160;</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">City, State, Zip</span><br/>&#160;</td></tr>
        <tr>
          <td width="35%" class="blank"><span class="label">Proj. No.</span><br/>&#160;</td>
          <td width="31%" class="blank"><span class="label">Phone:</span><br/>&#160;</td>
          <td width="34%" class="blank"><span class="label">Fax:</span><br/>&#160;</td>
        </tr>
        <tr><td colspan="3" align="center" class="party-title">General Contractor</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">Name</span><br/>&#160;</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">Address</span><br/>&#160;</td></tr>
        <tr><td colspan="3" class="blank"><span class="label">City, State, Zip</span><br/>&#160;</td></tr>
        <tr>
          <td width="35%" class="blank"><span class="label">Proj. No.</span><br/>&#160;</td>
          <td width="31%" class="blank"><span class="label">Phone:</span><br/>&#160;</td>
          <td width="34%" class="blank"><span class="label">Fax:</span><br/>&#160;</td>
        </tr>
      </table>
    </td>
    <td width="3%" style="padding: 0;"></td>
    <td width="47%" style="border: 0.5pt solid #000000; padding: 4pt;">Reviewer Stamp</td>
  </tr></table>
  <!-- Page 2: Product Summary line items -->
  <pbr/>
  <div class="lines-head">Product Summary</div>
  <div class="lines">
    <#assign hasLines = (record.lines?? && record.lines?size &gt; 0) />
    <#if hasLines>
      <table>
        <thead>
          <tr>
            <th class="num">#</th>
            <th>Description</th>
            <th>Model</th>
            <th>Manufacturer</th>
            <th class="right">Qty</th>
            <th>UoM</th>
            <th class="right">Unit Cost</th>
          </tr>
        </thead>
        <tbody>
          <#list record.lines as l>
            <tr>
              <td class="num">${(l.position!"")?xml}</td>
              <td>${(l.description!"")?xml}</td>
              <td>${(l.model!"")?xml}</td>
              <td>${(l.manufacturer!"")?xml}</td>
              <td class="right">${(l.qty!"")?xml}</td>
              <td>${(l.uom!"")?xml}</td>
              <td class="right">${(l.unitCost!"")?xml}</td>
            </tr>
          </#list>
        </tbody>
      </table>
    <#else>
      <table>
        <tr><td class="empty">No items on this submittal.</td></tr>
      </table>
    </#if>
  </div>


</body>
</pdf>
